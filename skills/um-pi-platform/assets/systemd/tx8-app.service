# tx8-app.service -- systemd unit template for a TX8 application.
# Replace every <app> / <user> placeholder, then install (requires sudo; ask the user first):
#   sudo install -m 0644 <app>.service /etc/systemd/system/<app>.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now <app>
#   journalctl -u <app> -f
# See skill um-pi-platform, references/build-and-deploy.md section 8.

[Unit]
Description=<app> (TX8 vision/inference service)
After=network-online.target
Wants=network-online.target
# Shared-mode MemryX manager. Check it exists first: systemctl list-unit-files | grep -i mxa
# Remove these two lines if the app uses local_mode=true (exclusive) and no manager.
After=mxa-manager.service
Wants=mxa-manager.service
# Give up after 5 crashes within 60 s (then the failure is visible in systemctl status).
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=<user>
Group=<user>
# Camera access; add the group that owns /dev/memx* if it is not root-only (ls -l /dev/memx*).
SupplementaryGroups=video
WorkingDirectory=/opt/<app>
ExecStart=/opt/<app>/bin/<app> --config /etc/<app>/<app>.conf
# The app must release MxAccl and stop camera channel 2 on SIGTERM within TimeoutStopSec.
KillSignal=SIGTERM
TimeoutStartSec=10
TimeoutStopSec=10
Restart=on-failure
RestartSec=2

# Logging: stdout/stderr go to journald (rate-limit in the app, never log per frame).
StandardOutput=journal
StandardError=journal
SyslogIdentifier=<app>

# Real-time priority: only if the app uses SCHED_FIFO/SCHED_RR threads (measure first).
#LimitRTPRIO=50
# CPU affinity for ALL threads of the service. Usually prefer pthread_setaffinity_np per thread.
# CPU 0 typically handles IRQs/USB on the TX8 -- verify with: cat /proc/interrupts
#CPUAffinity=1 2 3
LimitNOFILE=4096
# Allow mlock() on pre-allocated frame pools (up to 128 MB) to avoid page-fault jitter in RT paths.
LimitMEMLOCK=134217728
# Memory safety on 2 GB EVT / 4 GB MP boards: prevent runway leaks from crashing the kernel/comms,
# and protect the flight vision service from being picked first by the Linux OOM killer.
MemoryHigh=768M
MemoryMax=1024M
OOMScoreAdjust=-500
# Core dumps for crash analysis (needs systemd-coredump or a core_pattern; check on the board).
LimitCORE=infinity

# Light hardening that does not block /dev access to cameras or the MemryX device.
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
